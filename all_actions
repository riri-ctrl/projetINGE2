# ─── HELPERS ─────────────────────────────────────────────────────────────────

def flatten_columns(df: pd.DataFrame) -> pd.DataFrame:
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)
    return df


def compute_indicators(df: pd.DataFrame) -> pd.DataFrame:
    close = df["Close"]

    df["MA20"]          = close.rolling(20).mean()
    df["MA50"]          = close.rolling(50).mean()
    df["Momentum"]      = close.diff(10)
    df["RSI"]           = ta.momentum.RSIIndicator(close, window=14).rsi()

    macd = ta.trend.MACD(close, window_slow=26, window_fast=12, window_sign=9)
    df["MACD"]          = macd.macd()
    df["MACD_Signal"]   = macd.macd_signal()
    df["MACD_Hist"]     = macd.macd_diff()

    df["Volatility_20d"] = close.pct_change().rolling(20).std() * (252 ** 0.5)

    bb = ta.volatility.BollingerBands(close, window=20, window_dev=2)
    df["BB_Upper"]      = bb.bollinger_hband()
    df["BB_Lower"]      = bb.bollinger_lband()
    df["BB_Mid"]        = bb.bollinger_mavg()

    return df


def fetch_google_trends(keyword: str, start_year: int = 2004) -> pd.Series:
    try:
        pytrends    = TrendReq(hl="en-US", tz=0)
        all_chunks  = []
        current_year = pd.Timestamp.today().year

        for chunk_start in range(start_year, current_year + 1, 5):
            chunk_end = min(chunk_start + 4, current_year)
            pytrends.build_payload(
                [keyword], cat=0,
                timeframe=f"{chunk_start}-01-01 {chunk_end}-12-31",
                geo="", gprop=""
            )
            data = pytrends.interest_over_time()
            if not data.empty and keyword in data.columns:
                all_chunks.append(data[[keyword]])
            time.sleep(TRENDS_SLEEP)

        if not all_chunks:
            return pd.Series(dtype=float, name="Google_Trends")

        trends = pd.concat(all_chunks)
        trends = trends[~trends.index.duplicated(keep="last")]
        trends.index = pd.to_datetime(trends.index)
        daily = trends[keyword].resample("D").interpolate(method="linear")
        daily.name = "Google_Trends"
        return daily

    except Exception as e:
        print(f"      [!] Trends failed for '{keyword}': {e}")
        return pd.Series(dtype=float, name="Google_Trends")


def download_index(label: str, ticker: str) -> pd.DataFrame:
    raw = yf.download(ticker, start=START_DATE, auto_adjust=True, progress=False)
    raw = flatten_columns(raw)
    raw.index = pd.to_datetime(raw.index)
    raw.columns = [f"{label}_{c}" for c in raw.columns]
    return raw


# ─── CORE PROCESSING ─────────────────────────────────────────────────────────

def process_index(index_key: str, cfg: dict,
                  vix_close: pd.Series,
                  skip_trends: bool):

    label      = cfg["label"]
    output_dir = cfg["output_dir"]
    stocks     = cfg["stocks"]
    os.makedirs(output_dir, exist_ok=True)

    print(f"\n{'='*60}")
    print(f"  Processing {label} — {len(stocks)} stocks")
    print(f"  Output dir : ./{output_dir}/")
    print(f"{'='*60}\n")

    # Download own index
    print(f"  Downloading {label} index ({cfg['ticker']}) ...")
    try:
        idx_df = download_index(label, cfg["ticker"])
        print(f"  {len(idx_df)} trading days fetched.\n")
    except Exception as e:
        print(f"  [!] Could not download index: {e}. Continuing without it.\n")
        idx_df = pd.DataFrame()

    total = len(stocks)
    for i, (company_name, ticker) in enumerate(stocks.items(), 1):
        safe_name = ticker.replace(".", "_").replace("^", "").replace("-", "_")
        out_path  = os.path.join(output_dir, f"{safe_name}.csv")

        # ── Resume: skip if already done ──────────────────────────────────
        if os.path.exists(out_path):
            print(f"  [{i:03d}/{total}] {company_name} — already exists, skipping.")
            continue

        print(f"  [{i:03d}/{total}] {company_name} ({ticker})")

        # ── Download OHLCV ────────────────────────────────────────────────
        try:
            raw = yf.download(ticker, start=START_DATE,
                              auto_adjust=True, progress=False)
            if raw.empty:
                print(f"    [!] No data, skipping.\n")
                continue
            raw = flatten_columns(raw)
            raw.index = pd.to_datetime(raw.index)
        except Exception as e:
            print(f"    [!] Download failed: {e}\n")
            continue

        # ── Technical indicators ──────────────────────────────────────────
        df = compute_indicators(raw.copy())

        # ── Merge own index ───────────────────────────────────────────────
        if not idx_df.empty:
            df = df.join(idx_df, how="left")

        # ── Merge VIX ─────────────────────────────────────────────────────
        df = df.join(vix_close, how="left")

        # ── Google Trends ─────────────────────────────────────────────────
        if not skip_trends:
            print(f"    Fetching Google Trends ...")
            trends = fetch_google_trends(company_name)
            df["Google_Trends"] = trends if not trends.empty else float("nan")
            df = df.join(
                trends.rename("Google_Trends"), how="left"
            ) if not trends.empty else df.assign(Google_Trends=float("nan"))
        else:
            df["Google_Trends"] = float("nan")

        # ── Save ──────────────────────────────────────────────────────────
        df.index.name = "Date"
        df.sort_index(inplace=True)
        df.to_csv(out_path)
        print(f"    Saved -> {out_path}  ({len(df)} rows, {len(df.columns)} cols)\n")


# ─── MAIN ────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="Multi-index stock data fetcher")
    parser.add_argument(
        "--skip-trends", action="store_true",
        help="Skip Google Trends (much faster)"
    )
    parser.add_argument(
        "--index", choices=["cac40", "sp500", "sti"],
        help="Only process one index (default: all three)"
    )
    args = parser.parse_args()

    print("=" * 60)
    print("  Multi-Index Stock Data Fetcher")
    total_stocks = sum(len(v["stocks"]) for v in INDICES.values())
    print(f"  Total stocks : {total_stocks}")
    print(f"  Google Trends: {'DISABLED' if args.skip_trends else 'ENABLED'}")
    if args.index:
        print(f"  Running only : {args.index.upper()}")
    print("=" * 60)

    # Download VIX once — shared across all indices
    print(f"\nDownloading VIX ({VIX_TICKER}) ...")
    vix_raw   = yf.download(VIX_TICKER, start=START_DATE,
                             auto_adjust=True, progress=False)
    vix_raw   = flatten_columns(vix_raw)
    vix_close = vix_raw["Close"].copy()
    vix_close.name = "VIX_Close"
    vix_close.index = pd.to_datetime(vix_close.index)
    print(f"  {len(vix_close)} trading days fetched.")

    # Run selected indices
    keys_to_run = [args.index] if args.index else list(INDICES.keys())
    for key in keys_to_run:
        process_index(key, INDICES[key], vix_close, args.skip_trends)

    print("\n" + "=" * 60)
    print("  All done!")
    print(f"  cac40_data/  -> CAC40 stocks")
    print(f"  sp500_data/  -> S&P 500 stocks")
    print(f"  sti_data/    -> STI stocks")
    print("=" * 60)


if __name__ == "__main__":
    main()
